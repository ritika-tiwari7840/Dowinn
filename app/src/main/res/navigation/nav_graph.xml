<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/welcomeFragment">

    <fragment
        android:id="@+id/welcomeFragment"
        android:name="com.ritika.dowinnApp.WelcomeFragment"
        android:label="Home">
        <action
            android:id="@+id/action_welcomeFragment_to_sliderFragment"
            app:destination="@id/sliderFragment"
            app:popUpTo="@id/welcomeFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_global_sliderFragment"
            app:destination="@id/sliderFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/welcomeFragment"
            app:popUpToInclusive="true"/>
        <action
            android:id="@+id/action_global_taskFragment"
            app:destination="@id/taskFragment"
            app:launchSingleTop="true"
            app:popUpTo="@id/welcomeFragment"
            app:popUpToInclusive="true"/>

    </fragment>

    <fragment
        android:id="@+id/sliderFragment"
        android:name="com.ritika.dowinnApp.SliderFragment"
        android:label="Details">
        <action
            android:id="@+id/action_sliderFragment_to_taskFragment"
            app:destination="@id/taskFragment"
            app:popUpTo="@id/sliderFragment"
            app:popUpToInclusive="true"
            />
        <action
            android:id="@+id/action_sliderFragment_to_welcomeFragment"
            app:destination="@id/welcomeFragment" />
    </fragment>
    <fragment
        android:id="@+id/taskFragment"
        android:name="com.ritika.dowinnApp.TaskFragment"
        android:label="fragment_task"
        tools:layout="@layout/fragment_task" >
        <action
            android:id="@+id/action_taskFragment_to_welcomeFragment"
            app:destination="@id/welcomeFragment"
            app:popUpTo="@id/taskFragment"
            app:popUpToInclusive="true" />

    </fragment>

</navigation>
