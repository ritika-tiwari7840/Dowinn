<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <!-- Base App Theme -->
    <style name="Base.Theme.Dowinn" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/colorOnPrimaryContainer</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- Main Theme -->
    <style name="Theme.Dowinn" parent="Base.Theme.Dowinn" />

    <!-- Splash Screen Theme (Android 12+) -->
    <style name="Theme.Dowinn.Splash" parent="Theme.SplashScreen">
        <!-- Splash screen background -->
        <item name="windowSplashScreenBackground">@color/colorPrimaryContainer</item>

        <!-- Splash screen icon or animated logo -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/logo</item>

        <!-- Optional: icon background -->
        <item name="windowSplashScreenIconBackgroundColor">@color/colorPrimaryContainer</item>

        <!-- After splash, go to main theme -->
        <item name="postSplashScreenTheme">@style/Theme.Dowinn</item>
    </style>

    <!-- Text Styles -->
    <style name="welcome_to_">
        <item name="android:textSize">50sp</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:fontFamily">@font/bold</item>
    </style>

    <style name="stay_on_track">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/regular</item>
    </style>

    <!-- Buttons -->
    <style name="sign_in_button" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/grey</item>
        <item name="strokeWidth">2dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textColor">@color/grey</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/regular</item>
    </style>

    <style name="continue_button" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
        <item name="strokeColor">@color/colorPrimary</item>
        <item name="android:fontFamily">@font/semibold</item>
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="shapeAppearanceOverlay">@style/ContinueButtonShape</item>
    </style>

    <!-- Define rounded corners separately -->
    <style name="ContinueButtonShape" parent="">
        <item name="cornerSize">15dp</item>
    </style>

    <!-- Divider Style -->
    <style name="divider_style" parent="Widget.Material3.MaterialDivider">
        <item name="android:layout_width">70dp</item>
        <item name="android:layout_height">2dp</item>
        <item name="dividerColor">@color/dividerColor</item>
    </style>


    <!-- 🧭 Custom Toolbar Style -->
    <style name="Widget.Dowinn.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.Dowinn.Toolbar.Title</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.Dowinn.Toolbar.Subtitle</item>
        <item name="android:background">@color/colorPrimaryContainer</item>
        <item name="android:theme">@style/ThemeOverlay.Material3.Dark.ActionBar</item>
    </style>

    <!-- Title Text Appearance -->
    <style name="TextAppearance.Dowinn.Toolbar.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/colorOnPrimary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">@font/semibold</item>
    </style>

    <!-- Subtitle Text Appearance -->
    <style name="TextAppearance.Dowinn.Toolbar.Subtitle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/bold</item>
    </style>

    <style name="CustomToolbarTitle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:fontFamily">@font/bold</item>
        <item name="android:textSize">25sp</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="CustomNavigationItemText" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">18sp</item> <!-- Your desired size -->
        <item name="android:fontFamily">@font/regular</item> <!-- Your custom font -->
        <item name="android:textColor">#000000</item> <!-- Optional -->
    </style>

    <style name="MyCombinedStyle" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="strokeColor">@color/borderColor</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textColor">@color/borderColor</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/regular</item>
        <item name="shapeAppearanceOverlay">@style/AddButtonShape</item>
        <!-- Add more attributes from another style manually -->
    </style>

    <style name="AddButtonShape" parent="">
        <item name="cornerSize">15dp</item>
    </style>
    <style name="Widget.App.Dropdown" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="dropdownItem" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="strokeColor">@color/borderColor</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textColor">@color/borderColor</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/regular</item>
        <!-- Add more attributes from another style manually -->
    </style>

</resources>